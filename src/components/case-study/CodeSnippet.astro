---
import { Code } from 'astro:components';

interface Props {
  filename: string;
  lang: string;
  code: string;
}

const { filename, lang, code } = Astro.props;
---

<div class="overflow-hidden rounded-lg border sm:col-span-2" style="border-color: var(--border);">
  <div class="flex items-center gap-2 border-b px-4 py-2" style="border-color: var(--border); background: var(--bg-elevated);">
    <span class="h-2.5 w-2.5 rounded-full" style="background: #ff5f56;"></span>
    <span class="h-2.5 w-2.5 rounded-full" style="background: #ffbd2e;"></span>
    <span class="h-2.5 w-2.5 rounded-full" style="background: #27c93f;"></span>
    <span class="ml-2 text-xs font-mono" style="color: var(--text-muted);">{filename}</span>
  </div>
  <div class="overflow-x-auto text-sm" style={`background: var(--code-bg);`}>
    <Code code={code} lang={lang} theme="github-dark" />
  </div>
</div>
