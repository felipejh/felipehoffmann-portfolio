---
import { experience, education } from '../../data/experience';
---

<section id="experience" class="container section-divider fade-in py-10 sm:py-14">
  <h2 class="eyebrow">Experience</h2>
  <div class="flex flex-col gap-5">
    {
      experience.map((job, i) => (
        <div class="card hover-lift fade-in p-6" style={`--stagger-delay: ${i * 90}ms;`}>
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h3 class="text-base font-semibold" style="font-family: inherit; color: var(--text);">
                {job.role} · {job.company}
              </h3>
              <p class="text-sm" style="color: var(--text-muted);">
                {job.location}
              </p>
            </div>
            <span class="text-xs font-mono" style="color: var(--accent);">
              {job.dates}
            </span>
          </div>
          {job.bullets.length > 0 && (
            <ul class="flex flex-col gap-1.5 pl-4 text-sm leading-relaxed" style="color: var(--text-muted); list-style: disc;">
              {job.bullets.map((b) => (
                <li>{b}</li>
              ))}
            </ul>
          )}
        </div>
      ))
    }
  </div>

  <div class="mt-10">
    <h3 class="mb-3 text-xs font-semibold uppercase tracking-widest" style="color: var(--text-muted);">Education</h3>
    <div class="card hover-lift flex flex-wrap items-baseline justify-between gap-2 p-5">
      <div>
        <p class="text-sm font-semibold" style="font-family: inherit; color: var(--text);">{education.degree}</p>
        <p class="text-sm" style="color: var(--text-muted);">{education.school}</p>
      </div>
      <span class="text-xs font-mono" style="color: var(--accent);">{education.dates}</span>
    </div>
  </div>
</section>
