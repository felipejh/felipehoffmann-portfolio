---
import { experience, education } from '../../data/experience';
---

<section id="experience" class="container fade-in py-12">
  <h2 class="mb-6 text-xs font-semibold uppercase tracking-widest" style="color: var(--text-muted);">Experience</h2>
  <div class="flex flex-col gap-5">
    {
      experience.map((job) => (
        <div class="card p-6">
          <div class="mb-3 flex flex-wrap items-baseline justify-between gap-2">
            <div>
              <h3 class="text-base font-semibold" style="font-family: inherit; color: var(--text);">
                {job.role} · {job.company}
              </h3>
              <p class="text-sm" style="color: var(--text-muted);">
                {job.location}
              </p>
            </div>
            <span class="text-xs font-mono" style="color: var(--accent);">
              {job.dates}
            </span>
          </div>
          <ul class="flex flex-col gap-1.5 pl-4 text-sm leading-relaxed" style="color: var(--text-muted); list-style: disc;">
            {job.bullets.map((b) => (
              <li>{b}</li>
            ))}
          </ul>
        </div>
      ))
    }
    <p class="pl-1 text-sm" style="color: var(--text-muted);">
      {education.degree} — {education.school} ({education.dates})
    </p>
  </div>
</section>
