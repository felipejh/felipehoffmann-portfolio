---
import { profile } from '../../data/profile';
---

<section class="container grid items-center gap-10 pb-14 pt-20 sm:pb-16 sm:pt-28 lg:grid-cols-[1.2fr_auto]">
  <div class="flex flex-col gap-6">
    <p class="fade-in text-sm font-mono" style="color: var(--accent);">
      {profile.location} · {profile.timezone}
    </p>
    <h1 class="fade-in text-4xl font-bold sm:text-6xl" style="color: var(--text);">
      {profile.name}
    </h1>
    <h2 class="fade-in text-xl font-normal sm:text-2xl" style="color: var(--text-muted); font-family: inherit;">
      {profile.title}
    </h2>
    <p class="fade-in max-w-2xl text-base leading-relaxed sm:text-lg" style="color: var(--text-muted);">
      {profile.tagline}
    </p>
    <div class="fade-in flex flex-wrap gap-3 pt-2">
      <a
        href={profile.resumeUrl}
        class="badge-hover rounded-full px-5 py-2.5 text-sm font-medium"
        style="background: var(--accent); color: #05070c;"
      >
        View Resume
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        class="badge-hover rounded-full border px-5 py-2.5 text-sm font-medium"
        style="border-color: var(--border); color: var(--text);"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="badge-hover rounded-full border px-5 py-2.5 text-sm font-medium"
        style="border-color: var(--border); color: var(--text);"
      >
        Email
      </a>
    </div>
  </div>

  <div class="hero-phone-wrap fade-in hidden justify-self-center lg:block" style="--stagger-delay: 200ms;">
    <div class="hero-phone-float">
      <div id="hero-phone" class="w-56 overflow-hidden rounded-[2rem] border-4 shadow-2xl" style="border-color: #2a2f3a; background: #0d1017; transition: transform 0.15s ease-out;">
        <div class="flex items-center justify-between px-4 pb-2 pt-3 text-[10px]" style="color: #6b7280;">
          <span>9:41</span>
          <span>●●●</span>
        </div>
        <div class="flex flex-col gap-3 px-3 pb-5">
          <div class="h-3 w-20 rounded-full" style="background: var(--accent);"></div>
          <div class="rounded-xl p-3" style="background: var(--accent-soft);">
            <div class="mb-2 h-2 w-16 rounded-full" style="background: var(--accent);"></div>
            <div class="flex items-end gap-1.5">
              {[10, 18, 13, 22, 16, 24, 19].map((h) => (
                <span class="w-2 rounded-t-sm" style={`height: ${h}px; background: var(--accent);`} />
              ))}
            </div>
          </div>
          <div class="rounded-xl border p-3" style="border-color: #232833;">
            <div class="mb-1.5 h-2 w-24 rounded-full" style="background: #3a4150;"></div>
            <div class="h-2 w-14 rounded-full" style="background: #262c38;"></div>
          </div>
          <div class="rounded-xl border p-3" style="border-color: #232833;">
            <div class="mb-1.5 h-2 w-20 rounded-full" style="background: #3a4150;"></div>
            <div class="h-2 w-10 rounded-full" style="background: #262c38;"></div>
          </div>
          <div class="mt-1 h-9 rounded-full" style="background: var(--accent);"></div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const wrap = document.querySelector('.hero-phone-wrap');
  const phone = document.getElementById('hero-phone');
  if (wrap && phone && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    wrap.addEventListener('mousemove', (e) => {
      const evt = e as MouseEvent;
      const rect = (wrap as HTMLElement).getBoundingClientRect();
      const x = (evt.clientX - rect.left) / rect.width - 0.5;
      const y = (evt.clientY - rect.top) / rect.height - 0.5;
      phone.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 14}deg)`;
    });
    wrap.addEventListener('mouseleave', () => {
      phone.style.transform = '';
    });
  }
</script>
