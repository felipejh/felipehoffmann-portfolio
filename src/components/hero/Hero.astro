---
import { profile } from '../../data/profile';
---

<section class="container grid items-center gap-10 pb-14 pt-20 sm:pb-16 sm:pt-28 lg:grid-cols-[1.2fr_auto]">
  <div class="flex flex-col gap-6">
    <div class="fade-in flex flex-wrap items-center gap-x-4 gap-y-2">
      <p class="text-sm font-mono" style="color: var(--accent);">
        {profile.location} · {profile.timezone}
      </p>
      <span
        class="inline-flex items-center gap-2 rounded-full border px-3 py-1 text-xs font-medium"
        style="border-color: var(--border); color: var(--text);"
      >
        <span class="open-dot" aria-hidden="true"></span>
        Open to remote roles
      </span>
    </div>
    <h1 class="fade-in text-4xl font-bold sm:text-6xl" style="color: var(--text);">
      {profile.name}
    </h1>
    <h2 class="fade-in text-xl font-normal sm:text-2xl" style="color: var(--text-muted); font-family: inherit;">
      {profile.title}
    </h2>
    <p class="fade-in max-w-2xl text-base leading-relaxed sm:text-lg" style="color: var(--text-muted);">
      {profile.tagline}
    </p>
    <ul class="fade-in flex flex-wrap gap-x-2 gap-y-1 text-sm font-medium" style="color: var(--text);">
      {
        profile.highlights.map((h, i) => (
          <li class="flex items-center gap-2">
            {i > 0 && <span aria-hidden="true" style="color: var(--text-muted);">·</span>}
            {h}
          </li>
        ))
      }
    </ul>
    <div class="fade-in flex flex-wrap gap-3 pt-2">
      <a
        href={profile.resumeUrl}
        class="badge-hover rounded-full px-5 py-2.5 text-sm font-medium"
        style="background: var(--accent); color: var(--on-accent);"
      >
        View Resume
      </a>
      <a
        href={profile.linkedin}
        target="_blank"
        rel="noreferrer"
        class="badge-hover rounded-full border px-5 py-2.5 text-sm font-medium"
        style="border-color: var(--border); color: var(--text);"
      >
        LinkedIn
      </a>
      <a
        href={`mailto:${profile.email}`}
        class="badge-hover rounded-full border px-5 py-2.5 text-sm font-medium"
        style="border-color: var(--border); color: var(--text);"
      >
        Email
      </a>
    </div>
  </div>

  <div class="hero-phone-wrap fade-in hidden justify-self-center lg:block" style="--stagger-delay: 200ms;">
    <div class="hero-phone-float">
      <div id="hero-phone" class="relative h-[480px] w-[340px]" style="transition: transform 0.15s ease-out;">
        <a
          href="/projects/central-condo"
          class="hero-device absolute right-0 top-0 w-48 rotate-6"
          aria-label="Central Condo case study"
        >
          <img
            src="/images/screens/central-condo/mobile-resident-home.png"
            alt="Central Condo resident home screen"
            width="362"
            height="787"
            class="block h-auto w-full"
          />
        </a>
        <a
          href="/projects/acqua-san-pelegrino"
          class="hero-device absolute bottom-0 left-0 z-10 w-52 -rotate-3"
          aria-label="Acqua San Pelegrino case study"
        >
          <img
            src="/images/screens/acqua-san-pelegrino/student-home.png"
            alt="Acqua San Pelegrino student home screen"
            width="1206"
            height="2622"
            class="block h-auto w-full"
          />
        </a>
      </div>
    </div>
  </div>
</section>

<script>
  const wrap = document.querySelector('.hero-phone-wrap');
  const phone = document.getElementById('hero-phone');
  if (wrap && phone && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    wrap.addEventListener('mousemove', (e) => {
      const evt = e as MouseEvent;
      const rect = (wrap as HTMLElement).getBoundingClientRect();
      const x = (evt.clientX - rect.left) / rect.width - 0.5;
      const y = (evt.clientY - rect.top) / rect.height - 0.5;
      phone.style.transform = `rotateY(${x * 14}deg) rotateX(${-y * 14}deg)`;
    });
    wrap.addEventListener('mouseleave', () => {
      phone.style.transform = '';
    });
  }
</script>
