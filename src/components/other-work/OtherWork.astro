---
import { otherWork } from '../../data/other-work';
---

<section class="container section-divider fade-in py-16 sm:py-20">
  <h2 class="eyebrow">Other Work</h2>
  <div class="grid gap-4 sm:grid-cols-2">
    {
      otherWork.map((item, i) => (
        <div class="hover-lift rounded-lg border p-4" style={`border-color: var(--border); transition-delay: ${i * 90}ms;`}>
          <div class="mb-1 flex items-baseline justify-between gap-2">
            <h3 class="text-sm font-semibold" style="font-family: inherit; color: var(--text);">
              {item.name}
            </h3>
            <span class="text-xs" style="color: var(--text-muted);">
              {item.platforms}
            </span>
          </div>
          <p class="text-sm" style="color: var(--text-muted);">{item.description}</p>
        </div>
      ))
    }
  </div>
</section>
