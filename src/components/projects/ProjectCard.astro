---
import StoreButtons from './StoreButtons.astro';

interface Props {
  slug: string;
  title: string;
  tagline: string;
  platforms: { label: string; url?: string }[];
  stackTop: string[];
  index?: number;
}

const { slug, title, tagline, platforms, stackTop, index = 0 } = Astro.props;
---

<div
  class="card hover-lift fade-in relative flex flex-col gap-4 p-6"
  style={`--stagger-delay: ${index * 110}ms;`}
>
  <h3 class="text-xl font-semibold" style="font-family: inherit; color: var(--text);">
    <a href={`/projects/${slug}`} class="after:absolute after:inset-0 after:content-['']">
      {title}
    </a>
  </h3>
  <p class="text-sm leading-relaxed" style="color: var(--text-muted);">
    {tagline}
  </p>
  <div class="flex flex-wrap gap-2 pt-1">
    {
      stackTop.map((s) => (
        <span class="rounded-full border px-2.5 py-1 text-xs" style="border-color: var(--border); color: var(--text-muted);">
          {s}
        </span>
      ))
    }
  </div>
  <div class="mt-auto flex flex-col items-start gap-3 pt-2">
    <StoreButtons platforms={platforms} size="sm" class="relative z-10" />
    <span class="text-sm font-medium" style="color: var(--accent);">View full case study →</span>
  </div>
</div>
