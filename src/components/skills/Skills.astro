---
import { skillGroups } from '../../data/skills';
---

<section class="container section-divider fade-in py-10 sm:py-14">
  <h2 class="eyebrow">Skills</h2>
  <div class="grid gap-5 sm:grid-cols-2">
    {
      skillGroups.map((group, i) => (
        <div
          class="card hover-lift fade-in p-5"
          style={`transition-delay: ${i * 90}ms; --stagger-delay: ${i * 90}ms; ${group.featured ? 'border-color: var(--accent); background: var(--accent-soft);' : ''}`}
        >
          <h3
            class="mb-3 text-sm font-semibold"
            style={`font-family: inherit; color: ${group.featured ? 'var(--accent)' : 'var(--text)'};`}
          >
            {group.label}
          </h3>
          <div class="flex flex-wrap gap-2">
            {group.items.map((item) => (
              <span
                class="badge-hover rounded-full border px-3 py-1 text-xs"
                style="border-color: var(--border); color: var(--text-muted);"
              >
                {item}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
