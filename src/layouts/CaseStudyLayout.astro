---
import BaseLayout from './BaseLayout.astro';
import TechStackBadges from '../components/case-study/TechStackBadges.astro';
import ScreensGallery from '../components/case-study/ScreensGallery.astro';

interface Props {
  title: string;
  tagline: string;
  platforms: { label: string; url?: string }[];
  timeframe: string;
  status: string;
  role: string;
  problem: string;
  impact: string[];
  stack: {
    frontend: string[];
    backend: string[];
    infra: string[];
  };
  screens: { label: string; image?: string; kind: 'mobile' | 'web' }[];
}

const { title, tagline, platforms, timeframe, status, role, problem, impact, stack, screens } = Astro.props;
---

<BaseLayout title={`${title} — Case Study`} description={tagline}>
  <article class="container flex flex-col gap-16 py-16 sm:py-24">
    <header class="flex flex-col gap-4">
      <a href="/#projects" class="text-sm" style="color: var(--accent);">← Back to projects</a>
      <div class="flex flex-wrap gap-2">
        {
          platforms.map((p) =>
            p.url ? (
              <a
                href={p.url}
                target="_blank"
                rel="noreferrer"
                class="badge-hover rounded-full px-2.5 py-1 text-xs font-semibold underline-offset-2 hover:underline"
                style="background: var(--accent); color: #05070c;"
              >
                {p.label} ↗
              </a>
            ) : (
              <span
                class="coming-soon rounded-full border border-dashed px-2.5 py-1 text-xs font-medium"
                style="border-color: var(--text-muted); color: var(--text-muted);"
                title="Not publicly available yet"
              >
                {p.label} · soon
              </span>
            ),
          )
        }
        <span class="rounded-full border px-2.5 py-1 text-xs" style="border-color: var(--border); color: var(--text-muted);">
          {timeframe}
        </span>
        <span class="rounded-full border px-2.5 py-1 text-xs" style="border-color: var(--border); color: var(--text-muted);">
          Solo project · built with an AI-assisted workflow
        </span>
      </div>
      <h1 class="text-3xl font-bold sm:text-5xl" style="color: var(--text);">{title}</h1>
      <p class="max-w-2xl text-lg" style="color: var(--text-muted);">{tagline}</p>
    </header>

    <section class="grid gap-8 sm:grid-cols-3">
      <div class="sm:col-span-2">
        <h2 class="eyebrow">Problem</h2>
        <p class="leading-relaxed" style="color: var(--text);">{problem}</p>
      </div>
      <div>
        <h2 class="eyebrow">Role</h2>
        <p class="leading-relaxed" style="color: var(--text);">{role}</p>
      </div>
    </section>

    <section>
      <h2 class="eyebrow">Tech Stack</h2>
      <TechStackBadges stack={stack} />
    </section>

    <section>
      <h2 class="eyebrow">Architecture &amp; Engineering Highlights</h2>
      <div class="prose-case-study stagger-children grid gap-4 sm:grid-cols-2">
        <slot />
      </div>
    </section>

    <section>
      <h2 class="eyebrow">Screens</h2>
      <ScreensGallery screens={screens} />
    </section>

    <section>
      <h2 class="eyebrow">Impact / Status</h2>
      <ul class="flex flex-col gap-1.5 pl-4 text-sm leading-relaxed" style="color: var(--text-muted); list-style: disc;">
        {impact.map((line) => <li>{line}</li>)}
      </ul>
    </section>

    <a href="/#projects" class="text-sm" style="color: var(--accent);">← Back to projects</a>
  </article>
</BaseLayout>
